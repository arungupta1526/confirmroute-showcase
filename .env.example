# ==============================================================================
# ConfirmRoute AI — AWS Elastic Beanstalk Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000
NEXT_TELEMETRY_DISABLED=1

# Application Public URL
NEXT_PUBLIC_SITE_URL=https://confirmroute.in

# ------------------------------------------------------------------------------
# Railway Intelligence Microservice Gateway (Connects to Private Core Backend)
# ------------------------------------------------------------------------------
# Routes live chat reasoning, tools, and auth verification to the private Vercel backend
RAILWAY_GATEWAY_URL=https://confirmroute.com
RAILWAY_GATEWAY_SECRET=your_gateway_secret_token

# ------------------------------------------------------------------------------
# Database & Authentication (Supabase - Public Anon Key Only)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# ------------------------------------------------------------------------------
# Anti-Abuse & Rate Limiting (Cloudflare Turnstile - Public Site Key Only)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your_turnstile_site_key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
